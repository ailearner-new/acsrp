# CloudDesk Support - Environment Configuration
# Copy this file to .env and customize for your environment
# NEVER commit .env files to version control!

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=CloudDesk Support
APP_VERSION=0.1.0
ENVIRONMENT=development          # development, staging, production
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clouddesk

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# For local development with SQLite (when DATABASE_URL not set):
# DATABASE_URL=sqlite+aiosqlite:///./clouddesk.db

# =============================================================================
# Redis
# =============================================================================
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Kafka (Event Bus)
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=clouddesk-api

# Topic mappings
KAFKA_TOPIC_SUPPORT_REQUEST=support.request.created
KAFKA_TOPIC_TICKET_UPDATED=support.ticket.updated
KAFKA_TOPIC_ACTION_EXECUTED=support.action.executed

# =============================================================================
# JWT Authentication
# =============================================================================
# IMPORTANT: Change this in production! Use a strong random secret.
JWT_SECRET_KEY=dev-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTHENTICATED=120/minute
RATE_LIMIT_ADMIN=300/minute

# =============================================================================
# Vector Store
# =============================================================================
# Options: pinecone, weaviate, qdrant, memory
VECTOR_STORE_TYPE=memory

# Pinecone (if using)
# VECTOR_STORE_PINECONE_API_KEY=
# VECTOR_STORE_PINECONE_ENVIRONMENT=
# VECTOR_STORE_PINECONE_INDEX=clouddesk-knowledge

# Weaviate (if using)
# VECTOR_STORE_WEAVIATE_URL=http://localhost:8080
# VECTOR_STORE_WEAVIATE_API_KEY=

# Qdrant (if using)
# VECTOR_STORE_QDRANT_URL=http://localhost:6333
# VECTOR_STORE_QDRANT_API_KEY=

# =============================================================================
# Embeddings
# =============================================================================
# Options: openai, cohere, fake
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# OpenAI (if using)
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=

# Cohere (if using)
# COHERE_API_KEY=

# =============================================================================
# LLM Configuration
# =============================================================================
# Options: openai, anthropic, fake
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# OpenAI (if using)
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=

# Anthropic (if using)
# ANTHROPIC_API_KEY=

# =============================================================================
# Demo / Testing Mode
# =============================================================================
DEMO_MODE=true
FAKE_LLM_DELAY_MS=100

# Force fake providers for offline testing
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
VECTOR_STORE=memory
USE_FAKE_REDIS=true

# =============================================================================
# Security
# =============================================================================
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Trusted hosts
TRUSTED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json                   # json, console
LOG_FILE=                         # Optional: path to log file

# =============================================================================
# External Integrations (Optional - for production)
# =============================================================================

# Zendesk
# ZENDESK_SUBDOMAIN=your-subdomain
# ZENDESK_EMAIL=your-email@company.com
# ZENDESK_TOKEN=your-api-token

# Intercom
# INTERCOM_ACCESS_TOKEN=

# Stripe (Billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# SendGrid (Email)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=support@yourcompany.com

# =============================================================================
# Feature Flags
# =============================================================================
# ENABLE_VOICE_SUPPORT=false
# ENABLE_PROACTIVE_SUPPORT=false
# ENABLE_MULTI_LANGUAGE=false